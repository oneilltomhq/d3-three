{
	"name": "d3-three",
	"version": "0.1.0",
	"type": "module",
	"description": "Eighteen D3 gallery charts ported to three.js WebGPURenderer, graded pixel for pixel by an end-to-end harness",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oneilltomhq/d3-three.git"
	},
	"scripts": {
		"build:d3": "esbuild src/vendor/d3-entry.js --bundle --format=esm --outfile=examples/jsm/vendor/d3.js",
		"test": "node --test test/pack3.test.mjs",
		"e2e": "node test/e2e/puppeteer.js",
		"e2e:make": "node test/e2e/puppeteer.js --make",
		"e2e:twice": "node test/e2e/puppeteer.js --twice",
		"determinism": "node test/e2e/determinism.js",
		"serve": "node test/e2e/server.js"
	},
	"dependencies": {
		"@oneilltom/lib3": "0.5.0",
		"d3": "^7.9.0",
		"d3-force-3d": "^3.0.5"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"jpeg-js": "^0.4.4",
		"pngjs": "^7.0.0",
		"puppeteer": "25.9.0"
	}
}
